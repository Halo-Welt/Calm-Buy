DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# auto = 有豆包 Key 优先豆包，额度不足回退 Tavily；也可强制 doubao / tavily
SEARCH_PROVIDER=auto
DOUBAO_SEARCH_API_KEY=
TAVILY_API_KEY=
# 云函数限流标识盐值；正式环境必须替换
RATE_LIMIT_SALT=
# 微信一次性订阅消息模板（仅云函数使用）
REMINDER_TEMPLATE_ID=
REMINDER_THING_KEY=thing1
REMINDER_TIME_KEY=time2
MINIPROGRAM_STATE=formal
PORT=8787

