/* tabBar 是原生层，会盖住页面底部；这里预留出它和 home indicator 的高度 */
.index-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.sticker {
  display: inline-block;
  margin-top: 22rpx;
  padding: 14rpx 20rpx;
  background: #ddff32;
  box-shadow: 6rpx 6rpx 0 #101619;
  font-size: 24rpx;
  font-weight: 1000;
  line-height: 1.05;
  transform: rotate(-4deg);
}

.display-art {
  display: block;
  width: 100%;
  /* 图片自带约 37rpx 的米色留白，负边距收掉，否则和分隔线之间会空出一大段 */
  margin: 10rpx 0 -30rpx;
}

.marker-line {
  display: block;
  width: 100%;
  margin: -4rpx 0 8rpx;
}

.score-card,
.meter-card,
.input-card {
  position: relative;
  border: 5rpx solid #101619;
  border-radius: 28rpx;
  background: #fffdf8;
}

.status-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 48rpx;
}

.score-card {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: 36rpx 16rpx 16rpx;
  box-shadow: 8rpx 8rpx 0 #101619;
}

.card-tab {
  position: absolute;
  top: -24rpx;
  left: 16rpx;
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  background: #101619;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 1000;
}

.timer {
  color: #1648d8;
  font-family: "Arial Black", Arial, sans-serif;
  font-size: 48rpx;
  font-weight: 1000;
  letter-spacing: -2rpx;
  line-height: 1;
  text-align: center;
  transform: skewX(-5deg);
  font-variant-numeric: tabular-nums;
  -webkit-text-stroke: 2rpx #1648d8;
  text-shadow: -2rpx 0 #1648d8, 2rpx 0 #1648d8, 0 -2rpx #1648d8, 0 2rpx #1648d8;
}

.timer-idle {
  color: #a9a29a;
  -webkit-text-stroke-color: #a9a29a;
  text-shadow: none;
}

.timer-caption {
  margin-top: 10rpx;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.meter-card {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  padding: 36rpx 12rpx 16rpx;
  box-shadow: 8rpx 8rpx 0 #101619;
  transition: background-color 280ms ease-out;
}

.meter-card .card-tab {
  padding: 9rpx 16rpx;
  white-space: nowrap;
}

.meter-card-hover {
  filter: brightness(0.97);
}

.meter-card-overheat {
  box-shadow: 8rpx 8rpx 0 #ff543c;
}

.thermo {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thermo-overheat {
  animation: thermo-jitter 380ms steps(2, end) infinite;
}

.thermo-spill {
  position: absolute;
  top: -16rpx;
  left: 50%;
  z-index: 2;
  width: 28rpx;
  height: 22rpx;
  margin-left: -14rpx;
  border: 4rpx solid #101619;
  border-radius: 50% 50% 42% 42%;
}

.thermo-drop {
  position: absolute;
  z-index: 2;
  width: 10rpx;
  height: 14rpx;
  border: 3rpx solid #101619;
  border-radius: 50% 50% 50% 12%;
  animation: thermo-drip 900ms ease-in infinite;
}

.thermo-drop-a {
  top: -6rpx;
  left: 2rpx;
}

.thermo-drop-b {
  top: 8rpx;
  right: -2rpx;
  animation-delay: 280ms;
}

.thermo-ticks {
  position: absolute;
  top: 8rpx;
  left: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 132rpx;
}

.thermo-tick {
  width: 10rpx;
  height: 4rpx;
  background: #101619;
}

.thermo-tube {
  position: relative;
  width: 32rpx;
  height: 140rpx;
  overflow: hidden;
  border: 4rpx solid #101619;
  border-bottom: 0;
  border-radius: 20rpx 20rpx 0 0;
  background: #f5f1e8;
}

.thermo-fill {
  position: absolute;
  right: 3rpx;
  bottom: 0;
  left: 3rpx;
  height: 0;
  background: #1648d8;
  transition: height 280ms ease-out, background-color 280ms ease-out;
}

.thermo-bulb {
  width: 52rpx;
  height: 52rpx;
  margin-top: -10rpx;
  border: 4rpx solid #101619;
  border-radius: 50%;
  background: #1648d8;
}

.meter-score {
  margin-top: 8rpx;
  color: #1648d8;
  font-family: "Arial Black", Arial, sans-serif;
  font-size: 40rpx;
  font-weight: 1000;
  line-height: 1;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.meter-score-overheat {
  animation: score-pop 600ms ease-in-out infinite;
}

@keyframes thermo-jitter {
  0% { transform: translate(0, 0); }
  50% { transform: translate(-3rpx, 2rpx); }
}

@keyframes thermo-drip {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  80% { opacity: 1; }
  100% {
    opacity: 0;
    transform: translateY(36rpx);
  }
}

@keyframes score-pop {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

@media (prefers-reduced-motion: reduce) {
  .thermo-overheat,
  .thermo-drop,
  .meter-score-overheat {
    animation: none;
  }
}

.input-card {
  /* 额外补偿 .card-tab 向上溢出的 24rpx，避免标签压到上一张卡片 */
  margin-top: 62rpx;
  padding: 26rpx 16rpx 16rpx;
}

.input-card .field {
  margin: 0;
  border: 3rpx solid #101619;
  border-radius: 18rpx;
  background: #f5f1e8;
}

.hero-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-top: 20rpx;
  min-height: 104rpx;
  font-size: 38rpx;
  font-style: italic;
  letter-spacing: -3rpx;
}

.hero-button-hover {
  box-shadow: 2rpx 2rpx 0 #101619;
  transform: translate(6rpx, 6rpx);
}

.hero-button text {
  display: grid;
  width: 58rpx;
  height: 58rpx;
  place-items: center;
  border-radius: 50%;
  background: #ddff32;
  color: #101619;
  font-size: 34rpx;
}

.consent-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(16, 22, 25, 0.55);
}

.consent-dialog {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
  padding: 44rpx 36rpx 36rpx;
  border: 6rpx solid #101619;
  border-radius: 32rpx;
  background: #fffdf8;
  box-shadow: 14rpx 14rpx 0 #101619;
  animation: consent-pop 180ms ease-out;
}

@keyframes consent-pop {
  from {
    opacity: 0;
    transform: translateY(26rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.consent-tab {
  position: absolute;
  top: -24rpx;
  left: 28rpx;
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  background: #101619;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 1000;
}

.consent-title {
  font-size: 46rpx;
  font-weight: 1000;
  letter-spacing: -2rpx;
  line-height: 1.1;
  -webkit-text-stroke: 2rpx #101619;
}

.consent-body {
  margin-top: 20rpx;
  color: #41423f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.65;
}

.consent-confirm {
  margin-top: 34rpx;
}

.consent-decline {
  margin-top: 18rpx;
}

.consent-confirm-hover,
.consent-decline-hover {
  box-shadow: 2rpx 2rpx 0 #101619;
  transform: translate(6rpx, 6rpx);
}

