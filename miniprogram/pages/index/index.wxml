<view class="page index-page">
  <view class="sticker">冲动<br/>暂停一下</view>
  <image
    class="display-art"
    src="/assets/art/hero-dont-buy.jpg"
    mode="widthFix"
    aria-label="先别买"
  />
  <image
    class="marker-line"
    src="/assets/art/hero-underline.png"
    mode="widthFix"
    aria-hidden="true"
  />
  <view class="positioning-copy">先暂停一下，不是劝退。该买的，我会明确说可以买。</view>

  <view class="status-row">
    <view class="score-card" bindtap="openCooldowns" hover-class="score-card-hover">
      <view class="card-tab">冲动倒计时 ▶</view>
      <view class="timer {{hasCooldown ? '' : 'timer-idle'}}">{{timerText}}</view>
      <view class="timer-caption">{{timerCaption}}</view>
    </view>

    <view
      class="meter-card {{overheat ? 'meter-card-overheat' : ''}} {{temperature ? '' : 'meter-card-idle'}}"
      style="background: {{cardColor}};"
      hover-class="meter-card-hover"
      hover-stay-time="80"
      bindtap="explainTemperature"
    >
      <view class="card-tab">{{overheat ? '溢出来了 ▶' : '冲动温度 ▶'}}</view>
      <view class="thermo {{overheat ? 'thermo-overheat' : ''}}">
        <view class="thermo-spill" wx:if="{{overheat}}" style="background: {{thermoColor}};"></view>
        <view class="thermo-drop thermo-drop-a" wx:if="{{overheat}}" style="background: {{thermoColor}};"></view>
        <view class="thermo-drop thermo-drop-b" wx:if="{{overheat}}" style="background: {{thermoColor}};"></view>
        <view class="thermo-ticks">
          <view class="thermo-tick"></view>
          <view class="thermo-tick"></view>
          <view class="thermo-tick"></view>
          <view class="thermo-tick"></view>
        </view>
        <view class="thermo-tube">
          <view class="thermo-fill" style="height: {{meterWidth}}%; background: {{thermoColor}};"></view>
        </view>
        <view class="thermo-bulb" style="background: {{thermoColor}};"></view>
      </view>
      <view class="meter-score {{overheat ? 'meter-score-overheat' : ''}}" style="color: {{thermoColor}};">{{temperature}}°</view>
    </view>
  </view>

  <view class="input-card">
    <view class="card-tab">我在考虑买 ▶</view>
    <input
      class="field"
      maxlength="120"
      placeholder="{{placeholderText}}"
      value="{{productText}}"
      bindinput="onInput"
      confirm-type="go"
      confirm-hold="{{false}}"
      cursor-spacing="80"
      bindconfirm="start"
    />
  </view>
  <button
    class="primary-button hero-button"
    hover-class="hero-button-hover"
    hover-stay-time="80"
    bindtap="start"
  >开始冷静 <text>➜</text></button>

  <view class="consent-mask" wx:if="{{showConsent}}" catchtouchmove="noop">
    <view class="consent-dialog">
      <view class="consent-tab">隐私提醒 ▶</view>
      <view class="consent-title">开始智能分析</view>
      <view class="consent-body">你的商品描述与回答会发送至服务端、DeepSeek，并在需要时发送至豆包搜索或 Tavily；冷静记录仍只保存在本机。</view>
      <button
        class="primary-button consent-confirm"
        hover-class="consent-confirm-hover"
        hover-stay-time="80"
        bindtap="acceptConsent"
      >同意继续</button>
      <button
        class="secondary-button consent-decline"
        hover-class="consent-decline-hover"
        hover-stay-time="80"
        bindtap="declineConsent"
      >暂不使用</button>
    </view>
  </view>
</view>
