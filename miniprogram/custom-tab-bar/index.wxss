.tab-bar {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  background: #f5f1e8;
}

.slider {
  position: absolute;
  top: 16rpx;
  left: 0;
  z-index: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 33.333%;
  height: 64rpx;
  pointer-events: none;
}

.is-animating {
  transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
}

.pill {
  width: 160rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #1648d8;
}

.tab {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  background: transparent;
}

.tab-hover {
  opacity: 0.72;
}

.tab-selected.tab-hover {
  opacity: 1;
}

.tab-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 64rpx;
}

.icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.icon {
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.tab-selected .icon {
  filter: brightness(0) invert(1);
  transition: filter 0.16s ease 0.16s;
}

.label {
  width: 0;
  height: 36rpx;
  margin-left: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 36rpx;
  white-space: nowrap;
  opacity: 0;
}

.tab-selected .label {
  width: 48rpx;
  margin-left: 8rpx;
  opacity: 1;
  transition: opacity 0.16s ease 0.16s;
}
